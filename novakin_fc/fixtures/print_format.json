  "html": "<div class=\"nfc-card\">\n  <style>\n    .nfc-card { font-family: 'Helvetica Neue', Arial, sans-serif; color: #1a1a1a; max-width: 760px; margin: 0 auto; }\n    .nfc-hero { background: linear-gradient(135deg,#0e0e0e 0%,#22201a 100%); color: #fff; border-radius: 14px 14px 0 0; padding: 22px 26px; display: flex; align-items: center; gap: 20px; border-bottom: 4px solid #C9A227; }\n    .nfc-hero img.crest { width: 74px; height: 74px; object-fit: contain; }\n    .nfc-hero .who { flex: 1; }\n    .nfc-hero .club { font-size: 11px; letter-spacing: 3px; color: #C9A227; text-transform: uppercase; margin-bottom: 4px; }\n    .nfc-hero .name { font-size: 26px; font-weight: 800; margin: 0; line-height: 1.1; }\n    .nfc-hero .meta { margin-top: 6px; font-size: 13px; color: #d8d3c4; }\n    .nfc-hero .meta .dot { color:#C9A227; margin: 0 6px; }\n    .nfc-num { background:#C9A227; color:#0e0e0e; width: 62px; height: 62px; border-radius: 50%; display:flex; align-items:center; justify-content:center; font-size: 28px; font-weight: 900; }\n    .nfc-photo { width: 78px; height: 78px; border-radius: 10px; object-fit: cover; border: 2px solid #C9A227; background:#f2f2f2; }\n    .nfc-body { border: 1px solid #ece9e0; border-top: none; border-radius: 0 0 14px 14px; padding: 0; }\n    .nfc-sec-title { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color:#8a7a3d; font-weight: 700; padding: 16px 26px 8px; border-bottom: 1px solid #f0ede3; }\n    .nfc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding: 8px 26px 18px; }\n    .nfc-item { padding: 7px 0; font-size: 13px; }\n    .nfc-item .lbl { color:#8a8a8a; display:block; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; }\n    .nfc-item .val { font-weight: 600; color:#1a1a1a; }\n    .nfc-stats { display:grid; grid-template-columns: repeat(4,1fr); gap:12px; padding: 8px 26px 22px; }\n    .nfc-stat { background:#faf8f1; border:1px solid #efe9d6; border-radius:10px; text-align:center; padding:14px 6px; }\n    .nfc-stat .n { font-size: 22px; font-weight: 800; color:#0e0e0e; }\n    .nfc-stat .l { font-size: 10px; text-transform:uppercase; letter-spacing:.5px; color:#8a7a3d; margin-top:3px; }\n    .nfc-status { display:inline-block; padding:3px 12px; border-radius:20px; font-size:11px; font-weight:700; background:#C9A227; color:#0e0e0e; }\n    .nfc-foot { text-align:center; font-size:10px; color:#a99f80; padding:12px; font-style:italic; }\n  </style>\n\n  <div class=\"nfc-hero\">\n    <img class=\"crest\" src=\"/files/novakin-crest.png\" alt=\"NOVAKIN FC\">\n    <div class=\"who\">\n      <div class=\"club\">Novakin Football Club</div>\n      <h1 class=\"name\">{{ doc.nom_complet }}</h1>\n      <div class=\"meta\">\n        {% if doc.poste %}{{ doc.poste }}{% endif %}\n        {% if doc.categorie %}<span class=\"dot\">&bull;</span>{{ doc.categorie }}{% endif %}\n        {% if doc.matricule %}<span class=\"dot\">&bull;</span>{{ doc.matricule }}{% endif %}\n      </div>\n    </div>\n    {% if doc.photo %}<img class=\"nfc-photo\" src=\"{{ doc.photo }}\">{% endif %}\n    {% if doc.numero_maillot %}<div class=\"nfc-num\">{{ doc.numero_maillot }}</div>{% endif %}\n  </div>\n\n  <div class=\"nfc-body\">\n    <div class=\"nfc-sec-title\">Informations personnelles</div>\n    <div class=\"nfc-grid\">\n      <div class=\"nfc-item\"><span class=\"lbl\">Date de naissance</span><span class=\"val\">{{ frappe.format(doc.date_naissance, {'fieldtype':'Date'}) or '—' }}{% if doc.age %} ({{ doc.age }} ans){% endif %}</span></div>\n      <div class=\"nfc-item\"><span class=\"lbl\">Nationalité</span><span class=\"val\">{{ doc.nationalite or '—' }}</span></div>\n      <div class=\"nfc-item\"><span class=\"lbl\">Pied fort</span><span class=\"val\">{{ doc.pied_fort or '—' }}</span></div>\n      <div class=\"nfc-item\"><span class=\"lbl\">Statut</span><span class=\"val\"><span class=\"nfc-status\">{{ doc.statut or '—' }}</span></span></div>\n      <div class=\"nfc-item\"><span class=\"lbl\">Téléphone</span><span class=\"val\">{{ doc.telephone or '—' }}</span></div>\n      <div class=\"nfc-item\"><span class=\"lbl\">Email</span><span class=\"val\">{{ doc.email or '—' }}</span></div>\n    </div>\n\n    <div class=\"nfc-sec-title\">Contrat</div>\n    <div class=\"nfc-grid\">\n      <div class=\"nfc-item\"><span class=\"lbl\">Début du contrat</span><span class=\"val\">{{ frappe.format(doc.date_debut_contrat, {'fieldtype':'Date'}) or '—' }}</span></div>\n      <div class=\"nfc-item\"><span class=\"lbl\">Fin du contrat</span><span class=\"val\">{{ frappe.format(doc.date_fin_contrat, {'fieldtype':'Date'}) or '—' }}</span></div>\n      <div class=\"nfc-item\"><span class=\"lbl\">Durée</span><span class=\"val\">{% if doc.duree_contrat %}{{ doc.duree_contrat }} mois{% else %}—{% endif %}</span></div>\n      <div class=\"nfc-item\"><span class=\"lbl\">Agent</span><span class=\"val\">{{ doc.agent or '—' }}</span></div>\n    </div>\n\n    <div class=\"nfc-sec-title\">Statistiques sportives</div>\n    <div class=\"nfc-stats\">\n      <div class=\"nfc-stat\"><div class=\"n\">{{ doc.matchs_joues or 0 }}</div><div class=\"l\">Matchs</div></div>\n      <div class=\"nfc-stat\"><div class=\"n\">{{ doc.buts or 0 }}</div><div class=\"l\">Buts</div></div>\n      <div class=\"nfc-stat\"><div class=\"n\">{{ doc.passes_decisives or 0 }}</div><div class=\"l\">Passes D.</div></div>\n      <div class=\"nfc-stat\"><div class=\"n\">{{ doc.minutes_jouees or 0 }}</div><div class=\"l\">Minutes</div></div>\n      <div class=\"nfc-stat\"><div class=\"n\">{{ doc.cartons_jaunes or 0 }}</div><div class=\"l\">Cartons J.</div></div>\n      <div class=\"nfc-stat\"><div class=\"n\">{{ doc.cartons_rouges or 0 }}</div><div class=\"l\">Cartons R.</div></div>\n      <div class=\"nfc-stat\"><div class=\"n\">{{ \"%.2f\"|format(doc.ratio_buts or 0) }}</div><div class=\"l\">Ratio buts</div></div>\n      <div class=\"nfc-stat\"><div class=\"n\">{{ doc.numero_maillot or '—' }}</div><div class=\"l\">Maillot</div></div>\n    </div>\n\n    {% if doc.notes_medicales or doc.blessures %}\n    <div class=\"nfc-sec-title\">Suivi médical</div>\n    <div class=\"nfc-grid\" style=\"grid-template-columns:1fr;\">\n      {% if doc.blessures %}<div class=\"nfc-item\"><span class=\"lbl\">Historique des blessures</span><span class=\"val\" style=\"font-weight:400;\">{{ doc.blessures }}</span></div>{% endif %}\n      {% if doc.notes_medicales %}<div class=\"nfc-item\"><span class=\"lbl\">Notes médicales</span><span class=\"val\" style=\"font-weight:400;\">{{ doc.notes_medicales }}</span></div>{% endif %}\n    </div>\n    {% endif %}\n\n    <div class=\"nfc-foot\">NOVAKIN FOOTBALL CLUB &mdash; Là où la gloire commence &bull; Fiche générée le {{ frappe.utils.formatdate(frappe.utils.nowdate(), 'dd/MM/yyyy') }}</div>\n  </div>\n</div>",
